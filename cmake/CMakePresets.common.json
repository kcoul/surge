{
  "version": 6,
  "configurePresets": [
    {
      "name": "common",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "host-juceaide-common",
      "hidden": true,
      "inherits": [
        "common"
      ],
      "cacheVariables": {
        "SURGE_HOST_JUCEAIDE_ONLY": "ON",
        "JUCE_BUILD_HELPER_TOOLS": "ON",
        "JUCE_BUILD_EXTRAS": "OFF",
        "JUCE_BUILD_EXAMPLES": "OFF"
      }
    },
    {
      "name": "host-midi-osc-bridge-common",
      "hidden": true,
      "inherits": [
        "common"
      ],
      "cacheVariables": {
        "SURGE_HOST_MIDI_OSC_BRIDGE_ONLY": "ON"
      }
    },
    {
      "name": "qnx-surge-common",
      "hidden": true,
      "inherits": [
        "common"
      ],
      "toolchainFile": "${sourceDir}/libs/JUCE/extras/Build/CMake/QNXAarch64Toolchain.cmake",
      "cacheVariables": {
        "SURGE_BUILD_FX": "OFF",
        "SURGE_BUILD_TESTRUNNER": "OFF",
        "SURGE_BUILD_CLAP": "OFF",
        "SURGE_BUILD_LV2": "OFF",
        "SURGE_SKIP_LUA": "TRUE",
        "SURGE_STANDALONE_AUTO_OSC_IN": "ON",
        "SST_PLUGININFRA_FILESYSTEM_FORCE_PLATFORM": "ON"
      }
    },
    {
      "name": "linux-aarch64-ubuntu-surge-common",
      "hidden": true,
      "inherits": [
        "common"
      ],
      "toolchainFile": "${sourceDir}/cmake/linux-aarch64-ubuntu-crosscompile-toolchain.cmake",
      "cacheVariables": {
        "SURGE_BUILD_FX": "OFF",
        "SURGE_BUILD_TESTRUNNER": "OFF",
        "SURGE_BUILD_CLAP": "OFF",
        "SURGE_BUILD_LV2": "OFF",
        "SURGE_SKIP_LUA": "TRUE",
        "SURGE_SKIP_VST3": "ON",
        "SURGE_STANDALONE_AUTO_OSC_IN": "ON",
        "SST_PLUGININFRA_FILESYSTEM_FORCE_PLATFORM": "ON"
      }
    },
    {
      "name": "linux-aarch64-ubuntu-midi-osc-bridge-common",
      "hidden": true,
      "inherits": [
        "common"
      ],
      "toolchainFile": "${sourceDir}/cmake/linux-aarch64-ubuntu-crosscompile-toolchain.cmake",
      "cacheVariables": {
        "SURGE_HOST_MIDI_OSC_BRIDGE_ONLY": "ON",
        "JUCE_JUCEAIDE_PATH": "${sourceDir}/libs/JUCE/build/JUCE-host/extras/Build/juceaide/juceaide_artefacts/Release/juceaide"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "common",
      "hidden": true,
      "inheritConfigureEnvironment": true
    }
  ]
}
