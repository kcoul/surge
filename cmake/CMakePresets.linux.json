{
  "version": 6,
  "include": [
    "CMakePresets.common.json"
  ],
  "configurePresets": [
    {
      "name": "host-juceaide-linux",
      "displayName": "Host juceaide (Linux)",
      "inherits": [
        "host-juceaide-common"
      ],
      "binaryDir": "${sourceDir}/libs/JUCE/build",
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "host-midi-osc-bridge-linux",
      "displayName": "Host MIDI to OSC bridge (Linux)",
      "inherits": [
        "host-midi-osc-bridge-common"
      ],
      "binaryDir": "${sourceDir}/extras/SurgeMidiToOscBridge/build",
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "qnx-surge-linux",
      "displayName": "QNX Surge XT (Linux host)",
      "inherits": [
        "qnx-surge-common"
      ],
      "binaryDir": "${sourceDir}/build",
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "environment": {
        "QNX_BASE": "$env{HOME}/qnx800",
        "QNX_HOST": "$env{HOME}/qnx800/host/linux/x86_64",
        "QNX_TARGET": "$env{HOME}/qnx800/target/qnx",
        "QNX_CONFIGURATION": "$env{HOME}/.qnx",
        "QNX_CONFIGURATION_EXCLUSIVE": "$env{HOME}/.qnx",
        "MAKEFLAGS": "",
        "PATH": "$env{HOME}/qnx800/host/linux/x86_64/usr/bin:$env{HOME}/qnx800/jre/bin:$env{HOME}/qnx800/host/common/bin:$penv{PATH}"
      },
      "cacheVariables": {
        "JUCE_JUCEAIDE_PATH": "${sourceDir}/libs/JUCE/build/JUCE-host/extras/Build/juceaide/juceaide_artefacts/juceaide"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "build-host-juceaide-linux",
      "displayName": "Build host juceaide (Linux)",
      "inherits": [
        "common"
      ],
      "configurePreset": "host-juceaide-linux",
      "targets": [
        "juceaide"
      ],
      "jobs": 4,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "build-host-midi-osc-bridge-linux",
      "displayName": "Build host MIDI to OSC bridge (Linux)",
      "inherits": [
        "common"
      ],
      "configurePreset": "host-midi-osc-bridge-linux",
      "targets": [
        "SurgeMidiToOscBridge"
      ],
      "jobs": 4,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "build-qnx-surge-linux",
      "displayName": "Build QNX Surge XT (Linux host)",
      "inherits": [
        "common"
      ],
      "configurePreset": "qnx-surge-linux",
      "targets": [
        "surge-xt_Standalone"
      ],
      "jobs": 4,
      "environment": {
        "QNX_BASE": "$env{HOME}/qnx800",
        "QNX_HOST": "$env{HOME}/qnx800/host/linux/x86_64",
        "QNX_TARGET": "$env{HOME}/qnx800/target/qnx",
        "QNX_CONFIGURATION": "$env{HOME}/.qnx",
        "QNX_CONFIGURATION_EXCLUSIVE": "$env{HOME}/.qnx",
        "MAKEFLAGS": "",
        "PATH": "$env{HOME}/qnx800/host/linux/x86_64/usr/bin:$env{HOME}/qnx800/jre/bin:$env{HOME}/qnx800/host/common/bin:$penv{PATH}"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    }
  ]
}
